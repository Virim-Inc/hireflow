          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- PHASE 2: RECRUITER SCREENING                                   -->
        <!-- ============================================================== -->
        <mxCell id="p2_box" value="PHASE 2: HIREFLOW UI SCREENING &amp; RECRUITER REVIEW" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontStyle=1;fontSize=13;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;fontColor=#334155;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="1500" height="230" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="&lt;b style='font-size:13px;color:#1e293b;'&gt;6. Displayed on HireFlow UI&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Candidate listed on &lt;b&gt;Candidates Page&lt;/b&gt;, &lt;b&gt;Pipeline&lt;/b&gt;, &amp; &lt;b&gt;Email Ranking&lt;/b&gt; with match scores and skill chips&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="465" width="370" height="100" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="&lt;b style='font-size:13px;color:#92400e;'&gt;Meets Initial Criteria?&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#78350f;'&gt;Review match scores &amp; skill fit&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontColor:#92400e;" vertex="1" parent="1">
          <mxGeometry x="720" y="450" width="220" height="130" as="geometry" />
        </mxCell>

        <mxCell id="n_rej1" value="&lt;b style='font-size:12px;color:#991b1b;'&gt;Archive / Rejected&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#7f1d1d;'&gt;Moved to rejected stage&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#f87171;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="490" width="190" height="50" as="geometry" />
        </mxCell>

