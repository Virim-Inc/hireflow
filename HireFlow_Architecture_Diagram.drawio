        <mxCell id="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748b;" edge="1" parent="1" source="n6" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#ef4444;fontColor=#ef4444;fontStyle=1;" edge="1" parent="1" source="d1" target="n_rej1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- PHASE 3: FLOWMINGO AI INTERVIEW LIFECYCLE                      -->
        <!-- ============================================================== -->
        <mxCell id="p3_box" value="PHASE 3: FLOWMINGO AI INTERVIEW AUTOMATION &amp; ASSESSMENT" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontStyle=1;fontSize=13;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=2;fontColor=#6b21a8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="670" width="1500" height="250" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="&lt;b style='font-size:13px;color:#6b21a8;'&gt;7. Click 'Invite to AI Interview'&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Recruiter selects target role / Flowmingo Interview Set&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8b4fe;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="745" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n8" value="&lt;b style='font-size:13px;color:#6b21a8;'&gt;8. Flowmingo API &amp; Auto Stage&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Creates candidate &amp; unique interview link.&lt;br/&gt;&lt;b style='color:#7e22ce;'&gt;Auto-transitions stage:&lt;/b&gt;&lt;br/&gt;&lt;code style='background:#f3e8ff;color:#6b21a8;font-weight:bold;'&gt;pipeline_stage = 'ai_interview'&lt;/code&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="735" width="270" height="120" as="geometry" />
        </mxCell>

        <mxCell id="n9" value="&lt;b style='font-size:13px;color:#6b21a8;'&gt;9. Automated Email Sent&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Candidate receives email with their personalized AI interview link&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8b4fe;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="745" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n10" value="&lt;b style='font-size:13px;color:#6b21a8;'&gt;10. Candidate Takes AI Test&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Completes video/voice technical &amp; behavioral evaluation in Flowmingo test room&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8b4fe;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="745" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n11" value="&lt;b style='font-size:13px;color:#6b21a8;'&gt;11. Flowmingo AI Evaluation&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Generates comprehensive scores (0-10), answer transcripts, and report URL&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8b4fe;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="745" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- Connectors Phase 3 -->
        <mxCell id="c8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#10b981;fontColor=#10b981;fontStyle=1;" edge="1" parent="1" source="d1" target="n7">
