        <!-- ============================================================== -->
        <!-- PHASE 5: BRANCHING PATHS                                       -->
        <!-- ============================================================== -->
        <mxCell id="p5_box" value="PHASE 5: INTERNAL IN-PERSON PIPELINE OR PARTNER COMPANY REFERRAL" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontStyle=1;fontSize=13;fillColor=#fff1f2;strokeColor=#f43f5e;strokeWidth=2;fontColor=#881337;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="1230" width="1500" height="300" as="geometry" />
        </mxCell>

        <!-- Path A -->
        <mxCell id="pathA1" value="&lt;b style='font-size:13px;color:#1e40af;'&gt;PATH A: In-Person Interview&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Move candidate to &lt;code style='background:#dbeafe;color:#1e40af;font-weight:bold;'&gt;in_person_interview&lt;/code&gt; in internal pipeline&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="1310" width="310" height="85" as="geometry" />
        </mxCell>

        <mxCell id="pathA2" value="&lt;b style='font-size:13px;color:#065f46;'&gt;Job Offer &amp; Hired 🎉&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#047857;'&gt;Candidate accepts offer &amp; status transitions to &lt;b&gt;'Hired'&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="1425" width="310" height="75" as="geometry" />
        </mxCell>

        <!-- Path B -->
        <mxCell id="pathB1" value="&lt;b style='font-size:13px;color:#9f1239;'&gt;PATH B: Refer to Partner Company&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Open &lt;b&gt;'Refer Candidate Modal'&lt;/b&gt;&lt;br/&gt;• Select Partner Company from Searchable Dropdown&lt;br/&gt;• Auto-populate Flowmingo score &amp; DB skills into Key Strengths&lt;br/&gt;• Customize verified rounds &amp; recommendation notes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#f43f5e;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="1300" width="460" height="130" as="geometry" />
        </mxCell>

        <mxCell id="pathB2" value="&lt;b style='font-size:13px;color:#9f1239;'&gt;Track in Referrals Hub&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Track candidate referral status across partner companies (&lt;i&gt;Shared, Interviewing, Offered, Hired&lt;/i&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb7185;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1320" width="460" height="90" as="geometry" />
        </mxCell>

        <!-- Path C -->
        <mxCell id="pathC" value="&lt;b style='font-size:12px;color:#991b1b;'&gt;Archive / Rejected&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#7f1d1d;'&gt;Does not meet score threshold&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#f87171;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="1450" width="190" height="50" as="geometry" />
