          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- PHASE 4: RESULTS INGESTION & UI REPORT                         -->
        <!-- ============================================================== -->
        <mxCell id="p4_box" value="PHASE 4: RESULTS INGESTION &amp; REPORT DISPLAY" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontStyle=1;fontSize=13;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#14532d;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="960" width="1500" height="230" as="geometry" />
        </mxCell>

        <mxCell id="n12" value="&lt;b style='font-size:13px;color:#15803d;'&gt;12. Webhook &amp; DB Sync&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;HireFlow receives completed test webhook. Updates candidate score &amp; report submission link&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1025" width="290" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n13" value="&lt;b style='font-size:13px;color:#15803d;'&gt;13. HireFlow UI Score &amp; Report Display&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Candidate row displays &lt;b style='color:#16a34a;'&gt;Flowmingo Score Badge (e.g. 8.8/10)&lt;/b&gt;&lt;br/&gt;Recruiter clicks &lt;b&gt;'View Flowmingo Report'&lt;/b&gt; to view AI report modal &amp; transcript&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="1015" width="430" height="120" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="&lt;b style='font-size:13px;color:#92400e;'&gt;Hiring Decision&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#78350f;'&gt;Evaluate AI Interview score&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontColor:#92400e;" vertex="1" parent="1">
          <mxGeometry x="410" y="1010" width="240" height="130" as="geometry" />
