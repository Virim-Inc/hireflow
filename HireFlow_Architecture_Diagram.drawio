<mxfile host="app.diagrams.net" modified="2026-09-02T13:30:00.000Z" agent="HireFlow" version="21.0.0" type="device">
  <diagram id="hireflow-e2e-clean" name="HireFlow E2E Recruitment Architecture">
    <mxGraphModel dx="1600" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Top Title Header -->
        <mxCell id="title" value="&lt;b style='font-size:24px;color:#1e1b4b;'&gt;HireFlow — End-to-End Recruitment &amp; AI Interview Architecture&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#64748b;'&gt;Automated pipeline from candidate resume parsing, JD scoring, Flowmingo AI interview assessment, to internal hire and partner referrals&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;arcSize=10;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="40" width="1200" height="75" as="geometry" />
        </mxCell>

        <!-- ============================================================== -->
        <!-- PHASE 1: APPLICATION & EXTRACTION                              -->
        <!-- ============================================================== -->
        <mxCell id="p1_box" value="PHASE 1: APPLICATION, WORKFLOW EXTRACTION &amp; SCORING" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontStyle=1;fontSize=13;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="1500" height="210" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="&lt;b style='font-size:13px;color:#0369a1;'&gt;1. Candidate Applies&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Fills form &amp; uploads resume PDF on Careers Portal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#38bdf8;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="210" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="&lt;b style='font-size:13px;color:#0369a1;'&gt;2. Zoho WorkDrive&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Resume PDF stored securely in designated cloud folder&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#38bdf8;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="210" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="&lt;b style='font-size:13px;color:#0369a1;'&gt;3. n8n / AI Workflow Engine&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Extracts categorized skills (Frontend, Backend, DB, AI/ML, Cloud), experience, education&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#38bdf8;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="210" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="&lt;b style='font-size:13px;color:#0369a1;'&gt;4. JD Match Scoring&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Computes technical, experience &amp; project match scores vs active Job Descriptions&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#38bdf8;strokeWidth=2;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="210" width="270" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="&lt;b style='font-size:13px;color:#0369a1;'&gt;5. PostgreSQL DB&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Profile saved with initial status:&lt;br/&gt;&lt;code style='background:#e0f2fe;color:#0284c7;font-weight:bold;'&gt;pipeline_stage = 'screening'&lt;/code&gt;&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor:#0369a1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="200" width="230" height="110" as="geometry" />
        </mxCell>

        <!-- Connectors Phase 1 -->
